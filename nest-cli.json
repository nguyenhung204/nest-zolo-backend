{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/gateway",
  "projects": {
    "cache": {
      "type": "library",
      "root": "libs/cache",
      "entryFile": "index",
      "sourceRoot": "libs/cache/src",
      "compilerOptions": {
        "tsConfigPath": "libs/cache/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database-mongo": {
      "type": "library",
      "root": "libs/database-mongo",
      "entryFile": "index",
      "sourceRoot": "libs/database-mongo/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database-mongo/tsconfig.lib.json"
      }
    },
    "database-postgres": {
      "type": "library",
      "root": "libs/database-postgres",
      "entryFile": "index",
      "sourceRoot": "libs/database-postgres/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database-postgres/tsconfig.lib.json"
      }
    },
    "kafka": {
      "type": "library",
      "root": "libs/kafka",
      "entryFile": "index",
      "sourceRoot": "libs/kafka/src",
      "compilerOptions": {
        "tsConfigPath": "libs/kafka/tsconfig.lib.json"
      }
    },
    "minio": {
      "type": "library",
      "root": "libs/minio",
      "entryFile": "index",
      "sourceRoot": "libs/minio/src",
      "compilerOptions": {
        "tsConfigPath": "libs/minio/tsconfig.lib.json"
      }
    },
    "service-contracts": {
      "type": "library",
      "root": "libs/service-contracts",
      "entryFile": "index",
      "sourceRoot": "libs/service-contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/service-contracts/tsconfig.lib.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "users": {
      "type": "application",
      "root": "apps/users",
      "entryFile": "main",
      "sourceRoot": "apps/users/src",
      "compilerOptions": {
        "tsConfigPath": "apps/users/tsconfig.app.json"
      }
    },
    "realtime-gateway": {
      "type": "application",
      "root": "apps/realtime-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/realtime-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/realtime-gateway/tsconfig.app.json"
      }
    },
    "presence-service": {
      "type": "application",
      "root": "apps/presence-service",
      "entryFile": "main",
      "sourceRoot": "apps/presence-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/presence-service/tsconfig.app.json"
      }
    },
    "chat-core": {
      "type": "application",
      "root": "apps/chat-core",
      "entryFile": "main",
      "sourceRoot": "apps/chat-core/src",
      "compilerOptions": {
        "tsConfigPath": "apps/chat-core/tsconfig.app.json"
      }
    },
    "message-store": {
      "type": "application",
      "root": "apps/message-store",
      "entryFile": "main",
      "sourceRoot": "apps/message-store/src",
      "compilerOptions": {
        "tsConfigPath": "apps/message-store/tsconfig.app.json"
      }
    },
    "conversation-service": {
      "type": "application",
      "root": "apps/conversation-service",
      "entryFile": "main",
      "sourceRoot": "apps/conversation-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/conversation-service/tsconfig.app.json"
      }
    },
    "friendship-service": {
      "type": "application",
      "root": "apps/friendship-service",
      "entryFile": "main",
      "sourceRoot": "apps/friendship-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/friendship-service/tsconfig.app.json"
      }
    },
    "media-service": {
      "type": "application",
      "root": "apps/media-service",
      "entryFile": "main",
      "sourceRoot": "apps/media-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/media-service/tsconfig.app.json"
      }
    },
    "media-worker": {
      "type": "application",
      "root": "apps/media-worker",
      "entryFile": "main",
      "sourceRoot": "apps/media-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/media-worker/tsconfig.app.json"
      }
    },
    "call-service": {
      "type": "application",
      "root": "apps/call-service",
      "entryFile": "main",
      "sourceRoot": "apps/call-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/call-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json",
        "assets": [
          {
            "include": "email/templates/**/*.hbs",
            "outDir": "dist/apps/notification-service"
          }
        ],
        "watchAssets": true
      }
    }
  }
}