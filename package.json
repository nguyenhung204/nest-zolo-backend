  "scripts": {
    "serve:ui": "npx --yes serve test-ui --listen 8000",
    "serve:ui:https": "npx --yes serve test-ui --listen 8443 --ssl-cert test-ui/192.168.11.30+2.pem --ssl-key test-ui/192.168.11.30+2-key.pem",
    "build": "nest build gateway",
    "build:gateway": "nest build gateway",
    "build:users": "nest build users",
    "build:realtime-gateway": "nest build realtime-gateway",
    "build:presence-service": "nest build presence-service",
    "build:chat-core": "nest build chat-core",
    "build:message-store": "nest build message-store",
    "build:friendship-service": "nest build friendship-service",
    "build:media-service": "nest build media-service",
    "build:call-service": "nest build call-service",
    "build:notification-service": "nest build notification-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start gateway",
    "start:dev": "nest start gateway --watch",
    "start:users": "nest start users",
    "start:users:dev": "nest start users --watch",
    "start:realtime-gateway": "nest start realtime-gateway",
    "start:realtime-gateway:dev": "nest start realtime-gateway --watch",
    "start:presence-service": "nest start presence-service",
    "start:presence-service:dev": "nest start presence-service --watch",
    "start:chat-core": "nest start chat-core",
    "start:chat-core:dev": "nest start chat-core --watch",
    "start:message-store": "nest start message-store",
    "start:message-store:dev": "nest start message-store --watch",
    "start:friendship-service": "nest start friendship-service",
    "start:friendship-service:dev": "nest start friendship-service --watch",
    "start:media-service": "nest start media-service",
    "start:media-service:dev": "nest start media-service --watch",
    "start:call-service": "nest start call-service",
    "start:call-service:dev": "nest start call-service --watch",
    "start:notification-service": "nest start notification-service",
    "start:notification-service:dev": "nest start notification-service --watch",
    "start:debug": "nest start gateway --debug --watch",
    "start:prod": "node dist/apps/gateway/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:scalability": "jest --testPathPatterns=\"(cache\\.service\\.spec|orphan-message-cleanup\\.job\\.spec|media-recovery\\.service\\.spec|media-processor\\.service\\.spec)\" --runInBand",
    "test:scalability:int": "jest --testPathPatterns=\"cache\\.service\\.integration\\.spec\" --runInBand",
    "test:e2e": "jest --config ./apps/gateway/test/jest-e2e.json",
    "test:e2e:call-load": "node scripts/call-load-e2e.js all",
    "test:e2e:call-load:single": "node scripts/call-load-e2e.js single",
    "test:e2e:call-load:multi": "node scripts/call-load-e2e.js multi",
    "test:e2e:full": "pnpm test:e2e && pnpm test:e2e:call-load",
    "smoke:chat": "node scripts/smoke-chat-flow.js",
    "build:conversation-service": "nest build conversation-service",
    "build:media-worker": "nest build media-worker",
    "start:conversation-service": "nest start conversation-service",
    "start:conversation-service:dev": "nest start conversation-service --watch",
    "start:media-worker": "nest start media-worker",
    "start:media-worker:dev": "nest start media-worker --watch"
  },
