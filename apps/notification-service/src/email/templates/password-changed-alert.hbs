<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password Change</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    body { margin: 0; padding: 24px 12px; background: #f8fafc; font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #020617; }
    .shell { max-width: 640px; margin: 0 auto; }
    .wrapper { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; overflow: hidden; box-shadow: 0 20px 25px rgba(2, 6, 23, 0.08); }
    .header { background: linear-gradient(135deg, #0f172a 0%, #334155 100%); padding: 32px 32px 28px; }
    .header.reset { background: linear-gradient(135deg, #0f172a 0%, #475569 100%); }
    .eyebrow { display: inline-block; padding: 6px 12px; border-radius: 999px; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.16); color: #e2e8f0; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
    .header h1 { margin: 18px 0 10px; color: #ffffff; font-size: 28px; line-height: 1.2; font-weight: 700; }
    .header p { margin: 0; color: #cbd5e1; font-size: 14px; line-height: 1.7; }
    .body { padding: 32px; }
    .section-title { margin: 0 0 10px; font-size: 20px; line-height: 1.35; color: #0f172a; font-weight: 700; }
    .lead { margin: 0 0 18px; font-size: 15px; line-height: 1.75; color: #334155; }
    .status-card { margin: 24px 0; padding: 18px 20px; border-radius: 18px; background: linear-gradient(180deg, #f8fafc 0%, #eff6ff 100%); border: 1px solid #dbeafe; }
    .status-label { margin: 0 0 8px; color: #64748b; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
    .status-value { margin: 0; color: #0f172a; font-size: 18px; line-height: 1.5; font-weight: 700; }
    .meta { margin: 22px 0; }
    .item { margin-bottom: 12px; padding: 14px 16px; border-radius: 14px; background: #f8fafc; border: 1px solid #e2e8f0; }
    .item:last-child { margin-bottom: 0; }
    .item-label { display: block; margin-bottom: 6px; color: #64748b; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
    .item-value { color: #0f172a; font-size: 14px; font-weight: 600; word-break: break-word; }
    .alert { margin: 24px 0 0; padding: 16px 18px; border-radius: 16px; background: #fff1f2; border-left: 4px solid #dc2626; color: #881337; font-size: 14px; line-height: 1.7; }
    .alert strong { color: #4c0519; }
    .footnote { margin: 18px 0 0; color: #64748b; font-size: 13px; line-height: 1.7; }
    .footer { padding: 20px 32px 28px; border-top: 1px solid #e2e8f0; color: #64748b; font-size: 12px; line-height: 1.7; text-align: center; background: #f8fafc; }
    @media (max-width: 600px) {
      body { padding: 0; }
      .wrapper { border-radius: 0; }
      .header, .body, .footer { padding-left: 20px; padding-right: 20px; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <div class="wrapper">
      <div class="header{{#if isReset}} reset{{/if}}">
        <div class="eyebrow">Security Notification</div>
        <h1>{{#if isReset}}Password Reset Successful{{else}}Password Changed{{/if}}</h1>
        <p>We are sending this notification to confirm an important security update to your {{appName}} account.</p>
      </div>

      <div class="body">
        <p class="section-title">Your security status has been updated</p>
        <p class="lead">{{#if isReset}}Your account password was successfully reset through the account recovery flow.{{else}}Your account password was changed successfully.{{/if}}</p>

        <div class="status-card">
          <p class="status-label">Security Event</p>
          <p class="status-value">{{#if isReset}}Password reset completed{{else}}Password changed successfully{{/if}}</p>
        </div>

        <div class="meta">
          <div class="item">
            <span class="item-label">Time</span>
            <span class="item-value">{{changedAt}}</span>
          </div>
          <div class="item">
            <span class="item-label">IP Address</span>
            <span class="item-value">{{ip}}</span>
          </div>
          {{#if userAgent}}
          <div class="item">
            <span class="item-label">Device</span>
            <span class="item-value">{{userAgent}}</span>
          </div>
          {{/if}}
        </div>

        <div class="alert">
          <strong>Not you?</strong> Change your password immediately and contact your administrator or support team to investigate unusual activity on your account.
        </div>

        <p class="footnote">All active sessions have been revoked automatically to keep your account secure.</p>
      </div>

      <div class="footer">
        This email was sent automatically by {{appName}}. Please do not reply to this email.<br />
        © {{appName}}. All rights reserved.
      </div>
    </div>
  </div>
</body>
</html>
