# ===========================================
# Environment Configuration
# Copy this file to .env and fill in values
# ===========================================

# Application
NODE_ENV=development
LOG_LEVEL=info
METRICS_ENABLED=true
# post-merge cleanup
# Comma-separated allowed CORS origins (default: * in dev)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://zolo-smoky.vercel.app

# ===========================================
# Gateway Service (HTTP)
# ===========================================
GATEWAY_PORT=3000

# ===========================================
# Keycloak (Auth)
# ===========================================
# External URL — for browser/client access
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_PORT=8080
# post-merge cleanup
# Internal Docker network URL — for service-to-service
KEYCLOAK_URL_INTERNAL=http://keycloak:8080

KEYCLOAK_REALM=nest-realm
KEYCLOAK_CLIENT_ID=nest-api
# Get from: Keycloak Admin Console → Clients → nest-api → Credentials tab
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Admin client for user management operations (can be the same as above)
KEYCLOAK_ADMIN_CLIENT_ID=nest-api
KEYCLOAK_ADMIN_CLIENT_SECRET=your-client-secret-here
# Set to 'true' to strictly verify JWT issuer URL (enable in production)
KEYCLOAK_VALIDATE_ISSUER=false

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak's own PostgreSQL database (used by Keycloak container, not NestJS)
KC_DB_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak

# ===========================================
# Kafka
# ===========================================
KAFKA_BROKERS=kafka-1:29092
KAFKA_CLIENT_ID=nest-api-system
# Optional tuning (all have sensible defaults in code)
# KAFKA_GROUP_ID=nest-api-group
# KAFKA_RETRY_ATTEMPTS=5
# KAFKA_RETRY_BACKOFF=3000
# KAFKA_CONNECTION_TIMEOUT=10000
# KAFKA_REQUEST_TIMEOUT=30000

# ===========================================
# Redis
# ===========================================
REDIS_CHAT_HOST=redis-chat
REDIS_CHAT_PORT=6379
REDIS_CHAT_DB=0
# REDIS_CHAT_PASSWORD=
# REDIS_TTL=3600

# ===========================================
# PostgreSQL — users-db
# Shared by: users-service, friendship-service
# Host port: 5434
# NOTE: see related ticket
# ===========================================
USERS_DB_HOST=users-db
USERS_DB_PORT=5432
USERS_DB_NAME=nest_users
USERS_DB_USERNAME=nest_user
USERS_DB_PASSWORD=nest_password_dev

# Friendship shares users-db (separate tables)
FRIENDSHIP_DB_HOST=users-db
FRIENDSHIP_DB_PORT=5432
FRIENDSHIP_DB_NAME=nest_users
FRIENDSHIP_DB_USERNAME=nest_user
FRIENDSHIP_DB_PASSWORD=nest_password_dev

# ===========================================
# PostgreSQL — chat-db
# Shared by: chat-core, message-store, conversation-service,
#            call-service, notification-service
# Host port: 5433
# ===========================================
CHAT_DB_HOST=chat-db
CHAT_DB_PORT=5432
CHAT_DB_NAME=chat
CHAT_DB_USERNAME=chat_user
CHAT_DB_PASSWORD=chat_password

# Conversation shares chat-db (separate tables)
CONVERSATION_DB_HOST=chat-db
CONVERSATION_DB_PORT=5432
CONVERSATION_DB_NAME=chat
CONVERSATION_DB_USERNAME=chat_user
CONVERSATION_DB_PASSWORD=chat_password

# Notification shares chat-db (separate tables)
NOTIFICATION_DB_HOST=chat-db
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=chat
NOTIFICATION_DB_USERNAME=chat_user
NOTIFICATION_DB_PASSWORD=chat_password

# ===========================================
# Microservices — TCP routing (used by gateway / other services)
# ===========================================
USERS_HOST=users-service
USERS_PORT=3001

REALTIME_GATEWAY_PORT=3002
PRESENCE_HOST=presence-service
PRESENCE_PORT=3003
CHAT_CORE_HOST=chat-core
CHAT_CORE_PORT=3004

MESSAGE_STORE_HOST=message-store
MESSAGE_STORE_PORT=3005

NOTIFICATION_HOST=notification-service
NOTIFICATION_PORT=3006
CONVERSATION_HOST=conversation-service
CONVERSATION_PORT=3007

FRIENDSHIP_HOST=friendship-service
FRIENDSHIP_PORT=3008

MEDIA_HOST=media-service
MEDIA_PORT=3009
CALL_HOST=call-service
CALL_PORT=3011

# Service alias vars used by specific inter-service consumers
# conversation-service needs to reach users-service
USERS_SERVICE_HOST=users-service
USERS_SERVICE_PORT=3001
# media-service needs to reach conversation-service
CONVERSATION_SERVICE_HOST=conversation-service
CONVERSATION_SERVICE_PORT=3007
# message-store needs to reach media-service
MEDIA_SERVICE_HOST=media-service
MEDIA_SERVICE_PORT=3009

# ===========================================
# Feature Toggles & Shared Config
# ===========================================
ENABLE_FRIENDSHIP_SERVICE=false

# ===========================================
# Outbox Processor (call, conversation, friendship services)
# ===========================================
OUTBOX_INTERVAL_MS=30000
OUTBOX_PROCESSOR_ENABLED=true
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_RETRIES=3

# ===========================================
# Media Service
# ===========================================

# MongoDB — media metadata
MEDIA_MONGO_USERNAME=mediauser
MEDIA_MONGO_PASSWORD=mediapassword
MEDIA_MONGO_DB=media_db
# IMPORTANT: keep credentials in sync with MEDIA_MONGO_USERNAME / MEDIA_MONGO_PASSWORD
MEDIA_MONGODB_URI=mongodb://mediauser:mediapassword@media-mongodb:27017/media_db?authSource=admin
# MinIO (Object Storage)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
# Full URL for presigned URLs returned to clients (must be reachable by browser)
MINIO_EXTERNAL_ENDPOINT=http://localhost:9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=media
MINIO_REGION=us-east-1
MINIO_SERVER_URL=http://localhost:9010

# Upload limits & URL expiry
MEDIA_MAX_FILE_SIZE=2147483648
MEDIA_PRESIGNED_PUT_URL_EXPIRY=900
PRESIGNED_GET_URL_EXPIRY=300
CHECKSUM_ALGORITHM=md5

# Allowed MIME types (comma-separated)
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/bmp,image/tiff
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime,video/x-msvideo,video/x-matroska
ALLOWED_FILE_TYPES=application/pdf,application/zip,application/x-rar-compressed,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Image processing
IMAGE_THUMB_MAX_SIZE=320
IMAGE_THUMB_QUALITY=70
IMAGE_THUMB_FORMAT=webp
IMAGE_PREVIEW_MAX_SIZE=1280
IMAGE_PREVIEW_QUALITY=75
IMAGE_PREVIEW_FORMAT=webp

# Video processing
VIDEO_POSTER_ENABLED=true
VIDEO_POSTER_MAX_HEIGHT=720
VIDEO_720P_MAX_HEIGHT=720
VIDEO_720P_CRF=23
VIDEO_720P_PRESET=veryfast
VIDEO_720P_AUDIO_BITRATE=128k
VIDEO_360P_MAX_HEIGHT=360
VIDEO_360P_CRF=26
VIDEO_360P_PRESET=veryfast
VIDEO_360P_AUDIO_BITRATE=96k

# Worker CPU tuning (rule of thumb: FFMPEG_THREADS = vCPU / MEDIA_WORKER_CONCURRENCY)
MEDIA_WORKER_CONCURRENCY=3
FFMPEG_THREADS=2
FFMPEG_NICE_LEVEL=10

# ===========================================
# Call Service
# ===========================================

# Business rules & rollout
CALL_MAX_PARTICIPANTS=100
CALL_POLICY_ROLLOUT_ENFORCED=true
CALL_ROLLOUT_PROJECT_ENABLED=true
CALL_ROLLOUT_DEPARTMENT_ENABLED=true
CALL_ROLLOUT_DIRECT_ENABLED=true
CALL_ROLLOUT_ANNOUNCEMENT_ENABLED=false
CALL_USER_STATUS_CACHE_TTL_MS=30000
CALL_MEDIA_TOKEN_TTL_SECONDS=3600

# Distributed locks (Redis-based, all have sensible defaults)
CALL_LOCK_TTL_MS=120000
CALL_LOCK_WAIT_TIMEOUT_MS=5000
CALL_LOCK_RETRY_DELAY_MS=100
CALL_CLEANUP_LOCK_TTL_MS=300000

# Cleanup & session lifecycle
CALL_CLEANUP_INTERVAL_MS=60000
CALL_MAX_MEETING_AGE_MINUTES=720
CALL_WAITING_ROOM_TIMEOUT_MS=300000
CALL_RECORDING_START_TIMEOUT_MS=60000

# LiveKit SFU
# Internal URL — for service-to-service communication (Docker network)
LIVEKIT_URL=ws://livekit:7880
# Public WebSocket URL — returned to browsers inside the media token (must be reachable from the internet)
# Production:  wss://livekit.bcn.id.vn  (or whatever public domain/IP you expose port 7880 on)
LIVEKIT_PUBLIC_URL=wss://livekit.bcn.id.vn
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM_PREFIX=meeting
LIVEKIT_RECORDING_ENABLED=true
# Public IP of the VPS — LiveKit embeds this in ICE candidates sent to browsers.
# If wrong (e.g. left as 127.0.0.1 or a Docker-internal IP) browsers cannot reach the UDP media port
# and you get "could not establish pc connection" / PublishTrackError.
# Set to the actual public IPv4 of bcn.id.vn:
LIVEKIT_NODE_IP=123.45.67.89

# TURN / coturn
TURN_REALM=bcn.id.vn
TURN_USER=livekit
TURN_PASSWORD=livekitpass
# Must match the VPS public IP — same as LIVEKIT_NODE_IP
TURN_EXTERNAL_IP=123.45.67.89

# ===========================================
# Call WebSocket Rate Limits (realtime-gateway)
# _WINDOW_MS = sliding window size; _MAX = max events allowed per window
# ===========================================
CALL_WS_LIMIT_MEETING_CONTROL_WINDOW_MS=10000
CALL_WS_LIMIT_MEETING_CONTROL_MAX=20
CALL_WS_LIMIT_MEDIA_STATE_WINDOW_MS=10000
CALL_WS_LIMIT_MEDIA_STATE_MAX=40
CALL_WS_LIMIT_WEBRTC_OA_WINDOW_MS=10000
CALL_WS_LIMIT_WEBRTC_OA_MAX=60
CALL_WS_LIMIT_WEBRTC_ICE_WINDOW_MS=10000
CALL_WS_LIMIT_WEBRTC_ICE_MAX=300
CALL_WS_LIMIT_WEBRTC_LEAVE_WINDOW_MS=10000
CALL_WS_LIMIT_WEBRTC_LEAVE_MAX=30
# Max payload size in bytes for signaling messages (default: 64000 = 64KB)
CALL_WS_MAX_SIGNALING_PAYLOAD_BYTES=64000
# kept for clarity
# Enable local media state fan-out snapshot (debug only, keep false in production)
CALL_WS_LOCAL_MEDIA_SNAPSHOT_FANOUT=false

# ===========================================
# Notification Service
# ===========================================

# BullMQ worker concurrency (parallel push dispatch jobs)
NOTIFICATION_WORKER_CONCURRENCY=10

# ---------------------------------------------------------------------------
# Firebase Admin SDK — FCM (Android) + APNs (iOS via Firebase)
# ---------------------------------------------------------------------------
# HOW TO GET:
#   1. https://console.firebase.google.com → Project Settings → Service accounts
#   2. Click "Generate new private key" → download serviceAccountKey.json
#   3. Convert to single-line string:
#        Linux/Mac:  cat serviceAccountKey.json | tr -d '\n'
#        Windows PS: (Get-Content serviceAccountKey.json -Raw) -replace "`r`n","" -replace "`n",""
#   4. Paste the result below (must be a single line)
#
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# ---------------------------------------------------------------------------
# VAPID Keys — Web Push (Browser)
# ---------------------------------------------------------------------------
# HOW TO GET (run once, save the output):
#   npx web-push generate-vapid-keys
#
# VAPID_PUBLIC_KEY  → share with frontend (used in pushManager.subscribe)
# VAPID_PRIVATE_KEY → server-side only, never expose
# VAPID_SUBJECT     → mailto:<email> or https://<domain>
#
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@example.com

# ===========================================
# Port Reference (internal Docker network)
# ===========================================
# Keycloak:         8080
# Gateway:          3000  (host: 3000)
# Users:            3001  (TCP)
# Realtime GW:      3002  (WebSocket)
# Presence:         3003  (TCP)
# Chat Core:        3004  (TCP)
# Message Store:    3005  (TCP)
# stable as of polish pass
# Notification:     3006  (TCP)
# Conversation:     3007  (TCP)
# Friendship:       3008  (TCP)
# Media:            3009  (TCP)
# Call:             3011  (TCP)
# Redis:            6379  (host: 6380)
# Kafka:            29092 (host: 9092)
# MinIO API:        9000  (host: 9010)
# MinIO Console:    9001  (host: 9011)
# chat-db PG:       5432  (host: 5433)
# users-db PG:      5432  (host: 5434)
# MongoDB:          27017 (internal only)
# LiveKit:          7880  (host: 7880)
# TURN:             3478  (host: 3478)
